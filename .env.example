# ── 필수 (Vercel 프로젝트 → Settings → Environment Variables) ─────────────
# Supabase 트랜잭션 풀러(6543) 주소. 앱 전용 계정 twb_app 사용
DATABASE_URL=postgresql://twb_app.<project-ref>:<password>@aws-1-ap-northeast-2.pooler.supabase.com:6543/postgres

# ── 미팅 녹음 AI (Gemini) ─────────────────────────────────────────────
# https://aistudio.google.com/apikey 에서 무료 발급
GEMINI_API_KEY=
# 오디오 입력을 지원하는 모델이면 무엇이든. 기본: gemini-flash-latest
GEMINI_MODEL=gemini-flash-latest

# ── 선택 ─────────────────────────────────────────────────────────────
MAX_MEMBERS=10
# 로컬 개발 시 Gemini 호출 없이 흐름만 확인
# GEMINI_MOCK=1
